{
  "name": "postmite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri dev",
    "ipc:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_ipc --features ipc-export --locked",
    "ipc:check": "pnpm ipc:generate && git diff --exit-code -- src/shared/api/generated/ipc.ts",
    "typecheck": "pnpm ipc:check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:web": "vite build",
    "build": "pnpm typecheck && pnpm build:web",
    "build:tauri": "tauri build --no-bundle",
    "build:tauri:ci": "tauri build --no-bundle --ci --config src-tauri/tauri.ci.conf.json",
    "ci:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "ci:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "ci:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "ci:rust": "pnpm ci:rust:fmt && pnpm ci:rust:clippy && pnpm ci:rust:test",
    "test:readme": "node --test scripts/readme.node.mjs",
    "ci:frontend": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:readme && pnpm build:web",
    "ci:build": "pnpm build:web && pnpm build:tauri:ci",
    "screenshots:ui": "playwright test -c playwright.screenshots.config.ts",
    "e2e:request": "node scripts/e2e-request.mjs",
    "e2e:request:transport": "node scripts/e2e-request-transport.mjs",
    "e2e:security": "node scripts/e2e-security.mjs",
    "security:scan-fixtures": "node scripts/security-scan-fixtures.mjs",
    "perf:release": "node scripts/perf-release.mjs",
    "perf:release:strict": "POSTMITE_PERF_STRICT=1 node scripts/perf-release.mjs",
    "release:bundle": "tauri build --bundles deb,appimage",
    "release:artifacts": "node scripts/release-artifacts.mjs collect",
    "release:verify-artifacts": "node scripts/release-artifacts.mjs verify",
    "release:verify": "node scripts/release-artifacts.mjs verify-source",
    "release:inspect-candidate": "node scripts/release-candidate.mjs inspect",
    "release:verify-candidate": "node --test scripts/release-candidate.node.mjs && node scripts/release-candidate.mjs verify-artifacts",
    "release:test-update-check": "cargo test --manifest-path src-tauri/Cargo.toml --locked application::update::tests"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.5.2",
    "@lezer/json": "^1.0.3",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
