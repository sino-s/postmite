{
  "name": "postmite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri dev",
    "ipc:generate": "cargo run --manifest-path src-tauri/Cargo.toml --bin export_ipc --locked",
    "ipc:check": "pnpm ipc:generate && git diff --exit-code -- src/shared/api/generated/ipc.ts",
    "typecheck": "pnpm ipc:check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "build:tauri": "tauri build --no-bundle",
    "ci:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "ci:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "ci:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "ci:rust": "pnpm ci:rust:fmt && pnpm ci:rust:clippy && pnpm ci:rust:test",
    "ci:frontend": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "ci:build": "pnpm build:tauri",
    "perf:release": "node scripts/perf-release.mjs",
    "perf:release:strict": "POSTMITE_PERF_STRICT=1 node scripts/perf-release.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
